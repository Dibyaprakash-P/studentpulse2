# Student Pulse Backend — Environment Variables Example
# Copy this file to .env and fill in the values.

APP_NAME=Student Pulse
APP_VERSION=1.0.0
DEBUG=False

# Database — use SQLite for local dev, PostgreSQL for production
# Local:  sqlite+aiosqlite:///./student_pulse.db
# Render: (auto-injected by Render from the database service)
DATABASE_URL=sqlite+aiosqlite:///./student_pulse.db

# JWT — CHANGE THIS in production!
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ML Model path
ML_MODEL_PATH=app/ml/model.pkl
